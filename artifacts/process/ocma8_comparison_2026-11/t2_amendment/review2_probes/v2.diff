+def table_cells(line: str, outer: bool = False) -> List[str]:
+    """Cells of a markdown table row. A pipe preceded by a backslash does not split.
+    ``outer`` False strips every outer pipe; True drops exactly the first and last segment."""
+    text = line if outer else line.strip().strip("|")
+    parts, cur = [], []
+    for i, ch in enumerate(text):
+        if ch == "|" and (i == 0 or text[i - 1] != "\\"):
+            parts.append("".join(cur))
+            cur = []
+        else:
+            cur.append(ch)
+    parts.append("".join(cur))
+    if outer:
+        parts = parts[1:-1]
+    return [part.strip() for part in parts]
