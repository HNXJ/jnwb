diff --git a/scripts/tablecells.py b/scripts/tablecells.py
new file mode 100644
index 00000000..34b79c9d
--- /dev/null
+++ b/scripts/tablecells.py
@@ -0,0 +1,10 @@
+"""Splitting a markdown table row into cells on the pipes that are not escaped."""
+
+import re
+
+UNESCAPED_PIPE = re.compile(r"(?<!\\)\|")
+
+
+def split_cells(text: str) -> list[str]:
+    """The cells of ``text`` split on unescaped pipes, each cell trimmed."""
+    return [cell.strip() for cell in UNESCAPED_PIPE.split(text)]
