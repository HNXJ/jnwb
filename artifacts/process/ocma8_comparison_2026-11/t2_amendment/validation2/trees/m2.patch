diff --git a/scripts/cellsplit.py b/scripts/cellsplit.py
new file mode 100644
index 00000000..bfc50dfe
--- /dev/null
+++ b/scripts/cellsplit.py
@@ -0,0 +1,8 @@
+"""Splitting a markdown table row into cells on the pipes that are not escaped."""
+
+import re
+
+
+def split_cells(text: str) -> list[str]:
+    """The cells of ``text`` split on unescaped pipes, each cell trimmed."""
+    return [cell.strip() for cell in re.split(r"(?<!\\)\|", text)]
