diff --git a/scripts/table_rows.py b/scripts/table_rows.py
new file mode 100644
index 00000000..4fa0da68
--- /dev/null
+++ b/scripts/table_rows.py
@@ -0,0 +1,15 @@
+"""Markdown table rows split into cells on the pipes that are not escaped."""
+
+import re
+
+PATTERN = re.compile(r"(?<!\\)\|")
+
+
+def split_stripped(line: str) -> list[str]:
+    """The cells of a table row once its outer pipes are stripped, each cell trimmed."""
+    return [cell.strip() for cell in PATTERN.split(line.strip().strip("|"))]
+
+
+def split_inner(line: str) -> list[str]:
+    """The cells between the first and last pipe of a table row, each cell trimmed."""
+    return [cell.strip() for cell in PATTERN.split(line)[1:-1]]
