+
+
+def iter_cells(text: str) -> Iterator[str]:
+    """The cell texts of ``text``, one at a time, split at each pipe that no backslash escapes.
+
+    The backslash stays in the cell text. Outer pipes and whitespace are for the caller to remove.
+    """
+    start = 0
+    for pipe in _UNESCAPED_PIPE.finditer(text):
+        yield text[start:pipe.start()]
+        start = pipe.end()
+    yield text[start:]
