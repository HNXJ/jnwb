+#: A pipe that no backslash escapes: the boundary between two cells of a table row.
+_UNESCAPED_PIPE = re.compile(r"(?<!\\)\|")
 
 
 class Section(NamedTuple):
@@ -215,3 +217,15 @@ def parse_todo_stack(text: str) -> Tuple[List[Tuple[str, str, str]], List[str]]:
             unparseable.append(f"heading {title[:60]!r} sits at item depth outside any item and "
