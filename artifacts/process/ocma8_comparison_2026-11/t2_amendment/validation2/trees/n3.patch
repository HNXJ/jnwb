diff --git a/scripts/tableio/cells.py b/scripts/tableio/cells.py
new file mode 100644
index 00000000..3dfde4e2
--- /dev/null
+++ b/scripts/tableio/cells.py
@@ -0,0 +1,16 @@
+"""The cells of a markdown table row, split at the pipes that no backslash escapes."""
+
+from __future__ import annotations
+
+_ESCAPED_PIPE = "\\|"
+_SENTINEL = ""
+
+
+class CellSplitter:
+    """Splits a table row at its pipes; an escaped pipe stays inside its cell."""
+
+    @classmethod
+    def split(cls, text: str) -> list[str]:
+        """The cells of ``text``, each escaped pipe back in its cell with its backslash."""
+        protected = text.replace(_ESCAPED_PIPE, _SENTINEL)
+        return [cell.replace(_SENTINEL, _ESCAPED_PIPE) for cell in protected.split("|")]
