!artifacts/developer/RETIRED_prp_review_20260731.json
!artifacts/developer/RETIRED_prp_adapt_20260731.json
# Labyrinth graph state -- the PRP->Labyrinth migration (2026-07-28) never extended this
# whitelist to the replacement system, so the project's own knowledge graph was never
# git-tracked (found and fixed 2026-07-31, same session that found the analogous skill-
# registry gap left by the same migration).
!artifacts/.lab/*.json

# scratch and build artifacts
tmp/

# Large regenerable or archival binaries. The generators are tracked; the products are not.
#   context/manuscript-docx/     rebuild: scripts/build_draft_docx.py (from the markdown drafts)
#   context/draft-assets/        editable figure sources, kept on disk, too large for git
#   context/archive/             superseded handouts, preserved on disk under Conservation
context/manuscript-docx/
context/draft-assets/
context/archive/

# context/figures holds the manuscript figures 01-07 and is TRACKED on purpose.
# Only the finalized per-figure deliverables are tracked; nested working directories
# (svg/, artifacts/, supplements/) hold multi-MB/GB intermediates and stay ignored.
!context/figures/*.py
!context/figures/*.md
!context/figures/fig0*_finalized.svg
!context/figures/fig0*_finalized.png
!context/figures/fig0*_*/fig0*.svg
!context/figures/fig0*_*/fig0*.png
!context/figures/fig0*_*/fig0*.receipt.json
