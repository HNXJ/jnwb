{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jnwb dashboard data",
  "description": "Written by scripts/build_dashboard.py from committed records only. The page renders this file and computes no value of its own; a section whose source is missing is null, never filled in.",
  "type": "object",
  "required": ["generated", "sources", "release", "releases", "ci", "api", "verified", "performance", "order", "references", "figures", "showcases", "validations"],
  "properties": {
    "generated": {
      "type": "object",
      "required": ["commit", "date"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "date": {"type": "string", "description": "UTC, ISO 8601, from the commit, not the clock"}
      }
    },
    "sources": {
      "type": "object",
      "description": "Section name -> repository path it was read from",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "release": {
      "type": "object",
      "required": ["version", "date", "python", "links"],
      "properties": {
        "version": {"type": "string"},
        "date": {"type": "string"},
        "python": {"type": "array", "items": {"type": "string"}, "description": "pyproject classifiers"},
        "links": {
          "type": "object",
          "properties": {
            "pypi": {"type": "string"}, "docs": {"type": "string"},
            "repo": {"type": "string"}, "changelog": {"type": "string"}
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "description": "CHANGELOG.md sections, newest first; [Unreleased] excluded",
      "items": {
        "type": "object",
        "required": ["version", "date", "counts", "entries"],
        "properties": {
          "version": {"type": "string"},
          "date": {"type": "string"},
          "counts": {"type": "object", "additionalProperties": {"type": "integer"}, "description": "subsection heading -> bullet count"},
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "text"],
              "properties": {"kind": {"type": "string"}, "text": {"type": "string", "description": "the bullet as Markdown"}}
            }
          }
        }
      }
    },
    "ci": {
      "type": ["object", "null"],
      "description": "From .github/workflows/workflow.yml",
      "properties": {
        "legs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["python", "os"],
            "properties": {"python": {"type": "string"}, "os": {"type": "string"}, "note": {"type": "string"}}
          }
        }
      }
    },
    "api": {
      "type": ["object", "null"],
      "required": ["total", "groups"],
      "properties": {
        "total": {"type": "integer", "description": "len(jnwb.__all__)"},
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module", "symbols"],
            "properties": {
              "module": {"type": "string"},
              "extra": {"type": ["string", "null"], "description": "optional extra the module needs"},
              "symbols": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "verified": {
      "type": ["object", "null"],
      "description": "artifacts/process/frozen_validated.json",
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "qualname", "verified_at", "tests"],
            "properties": {
              "file": {"type": "string"}, "qualname": {"type": "string"},
              "verified_at": {"type": "string"}, "tests": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "performance": {
      "type": ["object", "null"],
      "properties": {
        "baseline": {
          "type": "array",
          "description": "artifacts/benchmarks/performance/baseline_performance.json",
          "items": {
            "type": "object",
            "required": ["name", "time_ms", "peak_mb", "scale"],
            "properties": {"name": {"type": "string"}, "time_ms": {"type": "number"}, "peak_mb": {"type": "number"}, "scale": {"type": "string"}}
          }
        },
        "peak_memory": {
          "type": ["object", "null"],
          "description": "artifacts/benchmarks/performance/peak_memory.json, fields copied as recorded",
          "properties": {
            "jnwb_version": {"type": "string"}, "commit": {"type": "string"},
            "python": {"type": "string"}, "platform": {"type": "string"}, "unit": {"type": "string"},
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "peak_mib", "added_mib", "added_is"],
                "properties": {"name": {"type": "string"}, "peak_mib": {"type": "number"}, "added_mib": {"type": "number"}, "added_is": {"type": "string"}}
              }
            }
          }
        },
        "import": {"type": ["object", "null"], "description": "artifacts/benchmarks/performance/import_breakdown.json, as recorded"}
      }
    },
    "order": {
      "type": ["array", "null"],
      "description": "Per-export computational order rows from the computational-order record",
      "items": {
        "type": "object",
        "required": ["export", "order"],
        "properties": {"export": {"type": "string"}, "order": {"type": "string"}, "evidence": {"type": "string"}, "module": {"type": "string", "description": "the jnwb.x heading above the row's table"}}
      }
    },
    "references": {
      "type": ["array", "null"],
      "description": "docs/references.md entries",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {"text": {"type": "string"}, "url": {"type": ["string", "null"]}}
      }
    },
    "figures": {
      "type": "array",
      "description": "docs/assets/figures pairs; paths relative to the built site",
      "items": {
        "type": "object",
        "required": ["id", "title", "light", "dark"],
        "properties": {
          "id": {"type": "string"}, "title": {"type": "string"},
          "light": {"type": "string"}, "dark": {"type": "string"},
          "docs_page": {"type": ["string", "null"], "description": "Read the Docs page that explains the figure"}
        }
      }
    },
    "deferred": {
      "type": ["array", "null"],
      "description": "Roadmap rows whose theme cell carries the validation tag, each read as not started, with the tag left off the theme. Null while the roadmap is absent.",
      "items": {
        "type": "object",
        "required": ["id", "theme", "defect", "waits", "release", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"}, "theme": {"type": "string"}, "defect": {"type": "string"},
          "waits": {"type": "string"}, "release": {"type": "string", "pattern": "^deferred-"},
          "label": {"enum": ["not started"]}
        }
      }
    },
    "validations": {
      "type": "array",
      "description": "Validation cards, one per receipt the build reads. Each names the file, the commit git last changed it in, its SHA-256 and the fields it states; a receipt that states its own commit also gives recorded_commit. html is the HTML output copied for the card, or null.",
      "items": {"$ref": "#/$defs/validation"}
    },
    "showcases": {
      "type": ["object", "null"],
      "description": "artifacts/showcases/openscope_glo.json, as recorded; null while no record exists. Figure paths are relative to the built site.",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": {
        "entries": {"type": "array", "items": {"$ref": "#/$defs/showcase"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "validation": {
      "type": "object",
      "required": ["id", "section", "title", "path", "commit", "sha256", "fields", "html"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "section": {"enum": ["calibration", "performance", "frozen", "studies", "closure"]},
        "title": {"type": "string"},
        "path": {"type": "string", "description": "repository-relative path of the receipt"},
        "commit": {"$ref": "#/$defs/commit"},
        "recorded_commit": {"$ref": "#/$defs/commit", "description": "the commit the receipt states"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "fields": {
          "type": "object",
          "additionalProperties": {"type": ["string", "integer", "array"], "items": {"type": "string"}}
        },
        "html": {"type": ["string", "null"]}
      }
    },
    "figure_file": {"type": "string", "pattern": "^assets/showcases/[A-Za-z0-9_.-]+\\.png$", "description": "a path under assets/showcases/ in the built site"},
    "showcase": {
      "type": "object",
      "required": ["id", "title", "question", "relation_to_published", "species", "status", "origin", "dandi", "jnwb", "figures", "result", "interpretation", "limitations", "code", "receipts", "replications", "links"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "question": {"type": "string"},
        "relation_to_published": {"type": "string"},
        "species": {"enum": ["mouse", "macaque"]},
        "status": {"enum": ["published", "exploratory", "verified"]},
        "origin": {
          "type": "object",
          "required": ["kind", "author", "issue"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["showcase", "contributor"]},
            "author": {"type": "string"},
            "issue": {"type": ["string", "null"]}
          }
        },
        "dandi": {
          "type": "object",
          "required": ["id", "version", "assets"],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string"},
            "version": {"type": "string"},
            "assets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["asset_id", "sha256"],
                "additionalProperties": false,
                "properties": {"asset_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
              }
            }
          }
        },
        "jnwb": {
          "type": "object",
          "required": ["commit", "functions"],
          "additionalProperties": false,
          "properties": {
            "commit": {"$ref": "#/$defs/commit"},
            "functions": {"type": "array", "items": {"type": "string"}}
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["light", "dark", "caption", "units", "controls", "uncertainty"],
            "additionalProperties": false,
            "properties": {
              "light": {"$ref": "#/$defs/figure_file"},
              "dark": {"$ref": "#/$defs/figure_file"},
              "caption": {"type": "string"},
              "units": {"type": "string"},
              "controls": {"type": "string"},
              "uncertainty": {"type": "string"}
            }
          }
        },
        "result": {"type": "string"},
        "interpretation": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "code": {
          "type": "object",
          "required": ["location", "commit"],
          "additionalProperties": false,
          "properties": {"location": {"type": "string"}, "commit": {"$ref": "#/$defs/commit"}}
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "sha256"],
            "additionalProperties": false,
            "properties": {"name": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
          }
        },
        "replications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["by", "date", "scope", "verdict", "seed", "report_sha256", "note"],
            "additionalProperties": false,
            "properties": {
              "by": {"type": "string"},
              "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "scope": {"type": "string"},
              "verdict": {"enum": ["reproduces", "partial", "does_not"]},
              "seed": {"type": ["string", "null"]},
              "report_sha256": {"$ref": "#/$defs/sha256"},
              "label": {"enum": ["reproduced", "mixed", "failed"], "description": "the dashboard's name for the verdict; the build adds it"},
              "note": {"type": "string"}
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {"label": {"type": "string"}, "url": {"type": "string"}}
          }
        }
      },
      "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
      "then": {"properties": {"replications": {"contains": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"const": "reproduces"}}}}}}
    }
  }
}
